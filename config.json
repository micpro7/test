{
  "ociVersion": "1.0.2",

  "hostname": "homebridge",

  "process": {
    "terminal": true,

    "cwd": "/homebridge",

    "args": [
      "/init"
    ],

    "env": [
      "HOME=/root",
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "TERM=xterm-256color",
      "NODE_ENV=production",
      "NODE_OPTIONS=--max-old-space-size=128",
      "HOMEBRIDGE_CONFIG_UI=1",
      "HOMEBRIDGE_CONFIG_PATH=/homebridge/config.json"
    ],

    "user": {
      "uid": 0,
      "gid": 0
    },

    "rlimits": [
      {
        "type": "RLIMIT_NOFILE",
        "soft": 65535,
        "hard": 65535
      }
    ]
  },

  "root": {
    "path": "rootfs",
    "readonly": false
  },

  "mounts": [
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc"
    },
    {
      "destination": "/dev",
      "type": "tmpfs",
      "source": "tmpfs"
    },
    {
      "destination": "/dev/pts",
      "type": "devpts",
      "source": "devpts"
    },
    {
      "destination": "/tmp",
      "type": "tmpfs",
      "source": "tmpfs"
    },
    {
      "destination": "/sys",
      "type": "sysfs",
      "source": "sysfs"
    }
  ],

  "linux": {
    "namespaces": [
      {
        "type": "pid"
      },
      {
        "type": "network"
      },
      {
        "type": "ipc"
      },
      {
        "type": "uts"
      },
      {
        "type": "mount"
      }
    ]
  }
}
