#!/bin/sh
#
# Homebridge UXC Runtime Init
# Designed for OpenWrt UXC micro-containers
# Runs as UID 0
#

set -e


echo "======================================"
echo " Homebridge UXC Container Starting"
echo "======================================"


# ==========================================================
# Environment
# ==========================================================

export NODE_ENV=production

export NODE_OPTIONS="--max-old-space-size=128"

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


# ==========================================================
# Persistent Directories
# ==========================================================

mkdir -p \
    /homebridge \
    /homebridge/accessories \
    /homebridge/backups \
    /homebridge/logs \
    /homebridge/persist



# ==========================================================
# Homebridge Config
# ==========================================================

if [ ! -f /homebridge/config.json ]; then

    echo "No Homebridge config found."

    cat > /homebridge/config.json <<'EOF'
{
    "bridge": {
        "name": "Homebridge UXC",
        "username": "0E:00:00:00:00:00",
        "port": 51826,
        "pin": "031-45-154"
    },

    "accessories": [],

    "platforms": []
}
EOF

fi



# ==========================================================
# Avahi mDNS
# ==========================================================

if command -v avahi-daemon >/dev/null 2>&1; then

    echo "Starting Avahi..."

    mkdir -p /run/avahi-daemon

    avahi-daemon \
        --daemonize \
        --no-chroot \
        2>/dev/null || true

fi



# ==========================================================
# Fix permissions
# ==========================================================

chmod -R 755 /homebridge



# ==========================================================
# Start Homebridge
# ==========================================================

echo "Starting Homebridge..."

exec homebridge \
    -U /homebridge
